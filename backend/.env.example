# Copia este archivo como .env y completa los valores.

# Origenes del frontend permitidos (separados por coma, sin "/" final).
ALLOWED_ORIGINS=http://localhost:5173

# Bucket de S3 con el modelo. Vacio = usar la carpeta local artifacts/.
S3_BUCKET=
S3_PREFIX=
AWS_REGION=us-east-1

# Documentacion Swagger en /api/docs (false en produccion).
ENABLE_DOCS=false
