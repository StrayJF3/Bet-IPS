# ============================================================
#  CONFIGURACION DEL BACKEND
#  Copia este archivo como  .env  y rellena los valores.
#     cp .env.example .env
# ============================================================

# 1) Dominios/origenes del frontend que pueden llamar a la API (separados por coma, sin "/" final).
#    En local:  http://localhost:5173
#    En el EC2: la IP o dominio donde abras el frontend. Ej: http://TU_IP_EC2:5173
ALLOWED_ORIGINS=http://localhost:5173

# 2) Documentacion Swagger en /api/docs. Dejar en false para el despliegue.
ENABLE_DOCS=false

# 3) AMAZON S3: de donde la API descarga el modelo al arrancar.
#    - Sube a tu bucket los 3 archivos que genera el notebook:
#        model.joblib, team_state.json, metrics.json
#    - El EC2 accede a S3 con su ROL IAM (NO se ponen claves de AWS aqui).
#    - Si dejas S3_BUCKET vacio, la API lee los 3 archivos de la carpeta local  artifacts/.
S3_BUCKET=nombre-de-tu-bucket
S3_PREFIX=
AWS_REGION=us-east-1
